<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.crystal.plugins</groupId>
        <artifactId>framework-build-plugin</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>framework-build-core</artifactId>
    <name>Crystal Plugins :: Build :: Core</name>
    <description>
        Build-tool agnostic half of the build plugin: bytecode analysis (ASM) of the compiled plugin, dependency
        pinning, metadata completion and jar finishing. The Maven plugin (and a future Gradle one) only adapt
        their project model to it.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm-commons</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.crystal.plugins</groupId>
            <artifactId>framework-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.crystal.plugins</groupId>
            <artifactId>framework-build-processor</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- The processor is a test dependency used to build fixtures; not for our own sources. -->
                    <proc>none</proc>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
