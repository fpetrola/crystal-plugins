<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.crystal.plugins</groupId>
        <artifactId>framework-build-plugin</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>framework-maven-plugin</artifactId>
    <packaging>maven-plugin</packaging>
    <name>Crystal Plugins :: Build :: Maven Plugin</name>
    <description>
        Declared once with extensions=true, it enables the role processor on the compile step and finishes the
        plugin jar (PF4J manifest + coordinates in plugin-metadata.json). No configuration required.
    </description>

    <prerequisites>
        <maven>3.8.1</maven>
    </prerequisites>

    <dependencies>
        <dependency>
            <groupId>dev.crystal.plugins</groupId>
            <artifactId>framework-build-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-plugin-api</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven</groupId>
            <artifactId>maven-core</artifactId>
            <version>${maven.api.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.maven.plugin-tools</groupId>
            <artifactId>maven-plugin-annotations</artifactId>
            <version>${maven.plugin.tools.version}</version>
            <scope>provided</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-plugin-plugin</artifactId>
                <configuration>
                    <goalPrefix>crystal</goalPrefix>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
