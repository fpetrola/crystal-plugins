<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stand-alone build (not part of the framework reactor): run `mvn install` at the root first.
  It plays the role of third parties: two unrelated host apps, their APIs, and plugins for each.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>examples-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <modules>
        <module>emulator-api</module>
        <module>reports-api</module>
        <module>plugin-beeper</module>
        <module>plugin-csv-exporter</module>
        <module>plugin-csv-semicolon</module>
        <module>plugin-markdown-exporter</module>
        <module>host-demo</module>
    </modules>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <crystal.version>0.1.0-SNAPSHOT</crystal.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.crystal.plugins</groupId>
                <artifactId>framework-api</artifactId>
                <version>${crystal.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>emulator-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.example</groupId>
                <artifactId>reports-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- The whole author-side setup. Declared once; modules without role implementations
                 (the APIs, the host) are left untouched. -->
            <plugin>
                <groupId>dev.crystal.plugins</groupId>
                <artifactId>framework-maven-plugin</artifactId>
                <version>${crystal.version}</version>
                <extensions>true</extensions>
            </plugin>
        </plugins>
    </build>
</project>
