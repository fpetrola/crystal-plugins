<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>examples-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>plugin-beeper</artifactId>
    <description>Emulator plugin: a beeper on port 0xFE.</description>

    <dependencies>
        <!-- Reduced environment: the app's API jar is all the author needs. 'provided' because the
             host supplies it at runtime; bundling it would break class identity across plugins. -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>emulator-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Testing the plugin on its own: the real runtime, no host application. -->
        <dependency>
            <groupId>dev.crystal.plugins</groupId>
            <artifactId>framework-test-harness</artifactId>
            <version>${crystal.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.9</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
