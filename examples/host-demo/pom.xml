<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.example</groupId>
        <artifactId>examples-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>host-demo</artifactId>
    <description>Two unrelated host apps driven by the same, unchanged framework.</description>

    <dependencies>
        <dependency>
            <groupId>dev.crystal.plugins</groupId>
            <artifactId>framework-runtime</artifactId>
            <version>${crystal.version}</version>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>emulator-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>reports-api</artifactId>
        </dependency>

        <!-- Plugin jars: declared only for reactor ordering and copying; kept OFF the classpath below. -->
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>plugin-beeper</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>plugin-csv-exporter</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>plugin-markdown-exporter</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.example</groupId>
            <artifactId>plugin-csv-semicolon</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>2.0.9</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>emulator-plugins</id>
                        <phase>process-test-resources</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeArtifactIds>plugin-beeper</includeArtifactIds>
                            <outputDirectory>${project.build.directory}/plugins/emulator</outputDirectory>
                        </configuration>
                    </execution>
                    <execution>
                        <id>reports-plugins</id>
                        <phase>process-test-resources</phase>
                        <goals><goal>copy-dependencies</goal></goals>
                        <configuration>
                            <includeArtifactIds>plugin-csv-exporter,plugin-markdown-exporter,plugin-csv-semicolon</includeArtifactIds>
                            <outputDirectory>${project.build.directory}/plugins/reports</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>com.example:plugin-beeper</classpathDependencyExclude>
                        <classpathDependencyExclude>com.example:plugin-csv-exporter</classpathDependencyExclude>
                        <classpathDependencyExclude>com.example:plugin-markdown-exporter</classpathDependencyExclude>
                        <classpathDependencyExclude>com.example:plugin-csv-semicolon</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                    <systemPropertyVariables>
                        <plugins.dir>${project.build.directory}/plugins</plugins.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
